# Bun / TypeScript (ADR 0034 port)
node_modules/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
**/.venv*/
venv/
*.egg-info/
dist/
build/

# Python tooling caches (mirrors content-hoarder/.gitignore)
.pytest_cache/
.pytest-tmp/
.pytest-review-tmp/
.pytest-*-tmp/
.ruff_cache/
.mypy_cache/

# Database (index is regenerated from vault)
*.db
*.db-shm
*.db-wal
.index/
.ledger/

# Ramp spools (personal message text waiting to be drained into the vault)
.incoming/

# Keep attachments mirror (runtime artifact, sha256-named files)
keep-media/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/settings.json
*.swp
*~

# Secrets
.env
*.env.local
.secrets/

# Claude Code machine-local permissions (skills/ stays tracked)
.claude/settings.local.json

# Autonomous/overnight run trail (local audit log; not part of the shipped project)
.autonomous/

# Impeccable live-mode runtime recovery state
.impeccable/live/sessions/

# Throwaway experiments and generated exports are local-only
spike/
exports/

# Archives and bundled vault duplicates must not be added accidentally
vault/**/*.zip
vault/**/*.tar
vault/**/*.tar.gz
vault/**/*.7z

# Personal vault content — kept local, not published (app recreates dirs on demand)
vault/daily/
vault/inbox/
vault/sources/
vault/media/
vault/areas/
vault/archive/
