[Unit]
Description=PKMS web service: capture endpoint, today view, PWA (port 8765)

[Service]
Type=exec
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin
EnvironmentFile=%h/.config/pkms/runtime.env
ExecStart=/bin/sh -c 'exec "$${PKMS_HOME:?PKMS_HOME must name the PKMS checkout}/bin/pkms" serve'
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
